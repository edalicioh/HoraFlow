# Banco SQLite local. Nunca apontar para public/ nem versionar o arquivo.
# Caminhos file: relativos são resolvidos a partir da raiz do projeto pelos
# scripts, pelo Prisma e pela aplicação.
DATABASE_URL="file:./data/horaflow.db"

# Porta publicada pelo Docker Compose apenas em 127.0.0.1.
# HORFLOW_PORT=3000

# Hosts adicionais aceitos pelo servidor (host ou host:porta, separados por
# vírgula). O padrão seguro aceita somente loopback: 127.0.0.1, localhost e
# [::1] em qualquer porta. Não use curingas. A ampliação vale apenas para
# acesso privado explicitamente configurado; não altera o endereço de escuta.
# HORAFLOW_TRUSTED_HOSTS="192.168.1.20:3000, horaflow.lan:3000"
