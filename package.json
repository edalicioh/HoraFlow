{
  "name": "horaflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/run-local.mjs development dev",
    "build": "prisma generate && next build",
    "start": "node scripts/run-local.mjs production start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:http": "pnpm build && vitest run --config vitest.http.config.ts",
    "test:e2e": "playwright test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm test:http",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/run-local.mjs production migrate",
    "db:migrate:dev": "node scripts/run-local.mjs development migrate-dev",
    "db:e2e:prepare": "node scripts/prepare-local-db.mjs && prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@next/env": "16.4.5",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-pdf/renderer": "^4.9.0",
    "better-sqlite3": "12.11.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
