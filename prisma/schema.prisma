generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

enum TimeEntryMode {
  DURATION
  INTERVAL
}

enum TimeEntryStatus {
  DRAFT
  BILLED
  APPROVED
}

enum BillingPeriodStatus {
  OPEN
  CLOSED
  REOPENED
}

enum ImportBatchStatus {
  PENDING
  PREVIEWED
  IMPORTED
  FAILED
}

model Client {
  id               String          @id @default(uuid())
  name             String
  description      String?
  hourlyRateCents  Int?
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  projects         Project[]
  billingPeriods   BillingPeriod[]

  @@index([active])
  @@index([name])
}

model Project {
  id               String      @id @default(uuid())
  clientId         String
  name             String
  description      String?
  hourlyRateCents  Int?
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  client           Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  timeEntries      TimeEntry[]

  @@index([clientId, active])
  @@index([name])
}

model TimeEntry {
  id                String           @id @default(uuid())
  projectId         String
  workDate          String
  mode              TimeEntryMode
  startAt           DateTime?
  endAt             DateTime?
  durationMinutes   Int
  description       String?
  hourlyRateCents   Int
  amountCents       Int
  billable          Boolean          @default(true)
  status            TimeEntryStatus  @default(DRAFT)
  deletedAt         DateTime?
  importBatchId     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  importBatch       ImportBatch?     @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  billingItems      BillingItem[]

  @@index([projectId, workDate])
  @@index([workDate])
  @@index([status])
  @@index([deletedAt])
  @@index([importBatchId])
}

model BillingPeriod {
  id                  String               @id @default(uuid())
  clientId            String
  year                Int
  month               Int
  revision            Int                  @default(1)
  status              BillingPeriodStatus  @default(OPEN)
  clientNameSnapshot  String?
  totalMinutes        Int                  @default(0)
  totalCents          Int                  @default(0)
  closedAt            DateTime?
  reopenedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  client              Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  items               BillingItem[]
  payments            Payment[]

  @@unique([clientId, year, month])
  @@index([status])
  @@index([year, month])
}

model BillingItem {
  id                String         @id @default(uuid())
  billingPeriodId   String
  timeEntryId       String
  revision          Int
  releasedAt        DateTime?
  clientName        String
  projectName       String
  description       String?
  workDate          String
  durationMinutes   Int
  hourlyRateCents   Int
  amountCents       Int
  billable          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  billingPeriod     BillingPeriod  @relation(fields: [billingPeriodId], references: [id], onDelete: Restrict)
  timeEntry         TimeEntry      @relation(fields: [timeEntryId], references: [id], onDelete: Restrict)

  @@unique([billingPeriodId, timeEntryId, revision])
  @@index([billingPeriodId, releasedAt])
  @@index([timeEntryId])
}

model Payment {
  id               String         @id @default(uuid())
  billingPeriodId  String
  revision         Int
  amountCents      Int
  paidAt           DateTime
  method           String?
  note             String?
  voidedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  billingPeriod    BillingPeriod  @relation(fields: [billingPeriodId], references: [id], onDelete: Restrict)

  @@index([billingPeriodId, revision])
  @@index([paidAt])
  @@index([voidedAt])
}

model Settings {
  id                     String   @id
  timezone               String   @default("America/Sao_Paulo")
  currency               String   @default("BRL")
  defaultHourlyRateCents Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  entity    String
  entityId  String
  action    String
  before    Json?
  after     Json?
  origin    String   @default("local")
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model ImportBatch {
  id             String             @id @default(uuid())
  status         ImportBatchStatus  @default(PENDING)
  fileName       String?
  fileHash       String?
  mapping        Json?
  errors         Json?
  totalRows      Int                @default(0)
  validRows      Int                @default(0)
  invalidRows    Int                @default(0)
  importedRows   Int                @default(0)
  totalMinutes   Int                @default(0)
  totalCents     Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  timeEntries    TimeEntry[]

  @@index([status])
  @@index([fileHash])
}
